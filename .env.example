# Public canonical origin, used for metadata (Open Graph / canonical URLs).
# No secrets belong in this file or in any NEXT_PUBLIC_* variable — they ship to the browser.
# Must be the address the site is actually served from: the apex redirects to www.
NEXT_PUBLIC_SITE_URL="https://www.cachewraith.com"

# Server-only: the console API the projects section is fetched from.
# Defaults to https://console.cachewraith.com/api/v1 — set it to use a local console.
# Must be https://; plain http:// is refused except for localhost / 127.0.0.1.
# CONSOLE_API_URL="http://127.0.0.1:8000/api/v1"
